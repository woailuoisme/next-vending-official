{
	"$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"app/**/*.tsx",
			"app/**/*.ts",
			"features/**/*.tsx",
			"features/**/*.ts",
			"components/**/*.tsx",
			"components/**/*.ts",
			"lib/**/*.tsx",
			"lib/**/*.ts"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "off",
				"useExhaustiveDependencies": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noExplicitAny": "off"
			},
			"a11y": {
				"useButtonType": "off",
				"noLabelWithoutControl": "off",
				"noStaticElementInteractions": "off",
				"useSemanticElements": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	}
}
